{
  "name": "askyoda",
  "version": "0.1.0",
  "description": "A reliability layer for TinyFish web agents: verifies every answer, diagnoses failures, patches the next attempt, and escalates to a human when a fix is impossible.",
  "keywords": [
    "tinyfish",
    "web-agent",
    "browser-agent",
    "reliability",
    "verification",
    "scraping",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "1sakshm",
  "homepage": "https://askyoda.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1sakshm/AskYoda.git",
    "directory": "packages/askyoda"
  },
  "bugs": {
    "url": "https://github.com/1sakshm/AskYoda/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "askyoda": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
